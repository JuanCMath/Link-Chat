# Base Docker image with all Link-Chat dependencies
# This image should be built once and reused for faster development builds
# 
# Build this image first:
#   docker build -f docker/base/Dockerfile.base -t linkchat-base:latest .
#
# Then use it in other Dockerfiles with:
#   FROM linkchat-base:latest

FROM python:3.13-slim

LABEL maintainer="Link-Chat Team"
LABEL description="Base image with all Link-Chat dependencies"
LABEL version="1.0"

# Install all system dependencies
RUN apt-get update && apt-get install -y \
    # PyQt6 GUI dependencies
    libgl1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxkbcommon-x11-0 \
    # EGL and OpenGL ES (REQUIRED for PyQt6)
    libegl1 \
    libgles2 \
    libxcb-glx0 \
    libxcb-cursor0 \
    # X11 libraries
    libx11-xcb1 \
    libxrender1 \
    libxi6 \
    libsm6 \
    libice6 \
    # Fonts for GUI
    fontconfig \
    fonts-dejavu-core \
    # Network debugging tools
    net-tools \
    iproute2 \
    iputils-ping \
    tcpdump \
    ethtool \
    # Development tools
    vim \
    nano \
    less \
    curl \
    wget \
    git \
    # Build tools (for Python packages with C extensions)
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# PyQt6 is the largest dependency (~100MB), install it here
RUN pip install --no-cache-dir \
    PyQt6>=6.6 \
    pytest>=8.0 \
    pytest-cov \
    pytest-timeout

# Set default working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Create common directories
RUN mkdir -p /app/downloads /app/logs

# Default command
CMD ["/bin/bash"]
