# Dockerfile for running tests (using base image)
# Fast rebuilds when code changes
#
# First build the base image:
#   docker build -f docker/base/Dockerfile.base -t linkchat-base:latest .
#
# Then build this image:
#   docker build -f docker/testing/Dockerfile.test -t linkchat-test .

FROM linkchat-base:latest

LABEL description="Unit testing image for Link-Chat"

# Copy project files
COPY pyproject.toml uv.lock* ./
COPY linkchat/ ./linkchat/
COPY tests/ ./tests/

# Install the package in development mode
RUN pip install --no-cache-dir -e .

# Set environment to avoid buffering
ENV PYTHONUNBUFFERED=1

# Default command runs all tests
CMD ["pytest", "tests/", "-v", "--tb=short"]
